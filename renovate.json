{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:allNonMajor",
    "helpers:pinGitHubActionDigests"
  ],
  "enabledManagers": [
    "composer",
    "github-actions"
  ],
  "timezone": "Asia/Tokyo",
  "schedule": [
    "before 9am on Monday"
  ],
  "dependencyDashboard": true,
  "labels": [
    "dependencies"
  ],
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "description": "Automatically merge stable non-major updates after CI succeeds",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest",
        "lockFileMaintenance"
      ],
      "addLabels": [
        "renovate-automerge"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false
    },
    {
      "description": "Require manual merge for major updates",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    }
  ]
}
