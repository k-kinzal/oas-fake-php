{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:allNonMajor",
    "helpers:pinGitHubActionDigests"
  ],
  "enabledManagers": [
    "composer",
    "github-actions"
  ],
  "timezone": "Asia/Tokyo",
  "schedule": [
    "before 9am on Monday"
  ],
  "dependencyDashboard": true,
  "labels": [
    "dependencies",
    "renovate-automerge"
  ],
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "vulnerabilityAlerts": {
    "minimumReleaseAge": "3 days"
  },
  "prConcurrentLimit": 5,
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": false,
  "gitIgnoredAuthors": [
    "41898282+github-actions[bot]@users.noreply.github.com"
  ],
  "packageRules": [
    {
      "description": "Widen constraints so the library keeps supporting existing versions; the lock sync workflow updates the per-PHP lock files",
      "matchManagers": [
        "composer"
      ],
      "rangeStrategy": "widen"
    }
  ]
}
