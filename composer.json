{
    "name": "k-kinzal/oas-fake-php",
    "description": "Intercept HTTP requests, validate against OpenAPI schemas, and generate fake responses for testing",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/k-kinzal/oas-fake-php",
    "keywords": [
        "openapi",
        "swagger",
        "mock",
        "fake",
        "testing",
        "http",
        "cassette",
        "guzzle",
        "curl"
    ],
    "authors": [
        {
            "name": "k-kinzal",
            "email": "keen.flag7803@logn.in"
        }
    ],
    "require": {
        "php": ">=8.0 <8.6",
        "ext-curl": "*",
        "canvural/php-openapi-faker": "^2.1",
        "devizzent/cebe-php-openapi": "^1.1.5",
        "guzzlehttp/psr7": "^2.0",
        "league/openapi-psr7-validator": ">=0.18, <1.0",
        "php-vcr/php-vcr": "^1.7"
    },
    "require-dev": {
        "brianium/paratest": "^6.11 || ^7",
        "friendsofphp/php-cs-fixer": "^3.95",
        "giorgiosironi/eris": "^0.14.1 || ^1.1",
        "guzzlehttp/guzzle": "^7.0",
        "k-kinzal/php-ai-toolkit": "dev-main",
        "nikic/php-fuzzer": "^0.0.11",
        "phpbench/phpbench": "^1.2.14",
        "phpcompatibility/php-compatibility": "^10.0@alpha",
        "phpstan/phpstan": "^1.12 || ^2.0",
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11 || ^12 || ^13",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "OasFake\\Exception\\": "src/Exception/",
            "OasFake\\": [
                "src/Application/Runtime/",
                "src/Application/",
                "src/Interception/",
                "src/Handling/",
                "src/Generation/",
                "src/OpenApi/"
            ]
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OasFake\\Tests\\Unit\\": [
                "tests/Unit/Application/Runtime/",
                "tests/Unit/Application/",
                "tests/Unit/Interception/",
                "tests/Unit/Handling/",
                "tests/Unit/Generation/",
                "tests/Unit/OpenApi/",
                "tests/Unit/Exception/"
            ],
            "OasFake\\Tests\\": "tests/",
            "OasFake\\Testing\\": "tests/Testing/"
        },
        "classmap": [
            "tests/Testing/DeclarativeServers.php",
            "tests/Testing/HandlerDeclarations.php"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "test": "@php tests/run.php --parallel --exclude-group=pbt",
        "test:coverage": "@php tests/run.php --exclude-group=pbt --coverage-xml build/coverage-xml",
        "test:unit": "@php tests/run.php --exclude-group=pbt",
        "test:pbt": "@php tests/run.php --group=pbt",
        "doctest": "@php tests/run.php --testsuite doctest --exclude-group=pbt",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "bench": "phpbench run --report=aggregate",
        "bench:quick": "phpbench run --report=aggregate --warmup=1 --iterations=3 --retry-threshold=10",
        "fuzz:routing": "php-fuzzer fuzz fuzz/routing.php fuzz/corpus/routing/",
        "fuzz:smoke": "@fuzz:routing --max-runs=1000",
        "compat": "phpcs",
        "loc-guard": "loc-guard --config=loc.yaml",
        "tree-guard": "tree-guard --config=tree.yaml",
        "deptrac": "deptrac analyse --config-file=deptrac.yaml --fail-on-uncovered --report-uncovered --no-progress",
        "docgen": "docgen --coverage=build/coverage-xml",
        "docgen:serve": "@docgen --serve",
        "docgen:diff": "@docgen --diff=main --serve",
        "docgen:fresh": "@docgen --no-cache",
        "lint": [
            "@format:check",
            "@phpstan",
            "@compat",
            "@loc-guard",
            "@tree-guard",
            "@deptrac"
        ],
        "format": "php-cs-fixer fix --allow-risky=yes",
        "format:check": "php-cs-fixer fix --dry-run --diff --allow-risky=yes"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "support": {
        "source": "https://github.com/k-kinzal/oas-fake-php",
        "issues": "https://github.com/k-kinzal/oas-fake-php/issues"
    },
    "repositories": [
        {
            "name": "php-ai-toolkit",
            "type": "vcs",
            "url": "https://github.com/k-kinzal/php-ai-toolkit.git"
        }
    ]
}
