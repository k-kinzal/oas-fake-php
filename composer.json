{
    "name": "k-kinzal/oas-fake-php",
    "description": "Intercept HTTP requests, validate against OpenAPI schemas, and generate fake responses for testing",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/k-kinzal/oas-fake-php",
    "keywords": [
        "openapi",
        "swagger",
        "mock",
        "fake",
        "testing",
        "http",
        "cassette",
        "guzzle",
        "curl"
    ],
    "authors": [
        {
            "name": "k-kinzal",
            "email": "keen.flag7803@logn.in"
        }
    ],
    "require": {
        "php": ">=8.0 <8.6",
        "ext-curl": "*",
        "canvural/php-openapi-faker": "^2.1",
        "devizzent/cebe-php-openapi": "^1.1.5",
        "guzzlehttp/psr7": "^2.0",
        "league/openapi-psr7-validator": ">=0.18, <1.0",
        "php-vcr/php-vcr": "^1.7"
    },
    "require-dev": {
        "brianium/paratest": "^6.11 || ^7",
        "deptrac/deptrac": "^0.24 || ^1.0 || ^2.0 || ^3.0 || ^4.6",
        "friendsofphp/php-cs-fixer": "^3.4",
        "guzzlehttp/guzzle": "^7.0",
        "infection/infection": "^0.26.19 || ^0.27 || ^0.28 || ^0.29 || ^0.30 || ^0.31 || ^0.32 || ^0.33 || ^0.34 || ^0.35",
        "k-kinzal/php-ai-toolkit": "dev-main",
        "phpcompatibility/php-compatibility": "^10.0@alpha",
        "phpstan/phpstan": "^1.12 || ^2.0",
        "phpstan/phpstan-strict-rules": "^1.6 || ^2.0",
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11 || ^12 || ^13",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "OasFake\\Exception\\": "src/Exception/",
            "OasFake\\": [
                "src/Application/",
                "src/Interception/",
                "src/Handling/",
                "src/Generation/",
                "src/OpenApi/"
            ]
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OasFake\\Tests\\Unit\\": [
                "tests/Unit/Application/",
                "tests/Unit/Interception/",
                "tests/Unit/Handling/",
                "tests/Unit/Generation/",
                "tests/Unit/OpenApi/",
                "tests/Unit/Exception/"
            ],
            "OasFake\\Tests\\": "tests/",
            "OasFake\\Testing\\": "tests/Testing/"
        },
        "classmap": [
            "tests/Testing/DeclarativeServers.php",
            "tests/Testing/HandlerDeclarations.php"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "infection/extension-installer": true
        }
    },
    "scripts": {
        "test": "paratest --processes=auto",
        "test:coverage": "@php -d memory_limit=1G -d xdebug.mode=coverage vendor/bin/phpunit --configuration phpunit.xml.dist --coverage-xml build/coverage-xml",
        "test:unit": "@php -d memory_limit=512M vendor/bin/phpunit --configuration phpunit.xml.dist",
        "test:unit:legacy": "@php -d memory_limit=512M vendor/bin/phpunit --configuration phpunit9.xml.dist",
        "doctest": "@php -d memory_limit=512M vendor/bin/phpunit --configuration phpunit.xml.dist --testsuite doctest",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "compat": "phpcs",
        "loc-guard": "loc-guard --config=loc.yaml",
        "tree-guard": "tree-guard --config=tree.yaml",
        "scope-guard": "scope-guard --config=scope.yaml",
        "deptrac": "@php deptrac.php analyse --config-file=deptrac.yaml",
        "doc-gen": "doc-gen --coverage=build/coverage-xml",
        "doc-gen:serve": "@doc-gen --serve",
        "doc-gen:diff": "@doc-gen --diff=main --serve",
        "doc-gen:fresh": "@doc-gen --no-cache",
        "lint": [
            "@format:check",
            "@phpstan",
            "@compat",
            "@loc-guard",
            "@tree-guard",
            "@scope-guard",
            "@deptrac"
        ],
        "format": "php-cs-fixer fix --allow-risky=yes",
        "format:check": "php-cs-fixer fix --dry-run --diff --allow-risky=yes"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "support": {
        "source": "https://github.com/k-kinzal/oas-fake-php",
        "issues": "https://github.com/k-kinzal/oas-fake-php/issues"
    },
    "repositories": [
        {
            "name": "php-ai-toolkit",
            "type": "vcs",
            "url": "https://github.com/k-kinzal/php-ai-toolkit.git"
        }
    ]
}
