<?xml version="1.0"?>
<ruleset name="oas-fake-php-compatibility">
    <description>Keep production and test code runnable on the declared PHP 8.0 floor.</description>

    <file>src</file>
    <file>tests</file>

    <config name="testVersion" value="8.0-"/>

    <rule ref="PHPCompatibility"/>
</ruleset>
