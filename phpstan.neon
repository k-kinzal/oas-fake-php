includes:
    - vendor/k-kinzal/php-ai-toolkit/error-formatter.neon

parameters:
    level: max
    paths:
        - src
        - tests
    excludePaths:
        - tests/Fixtures
    scanFiles:
        - stubs/OperationInfo.php
    # Development tools run on PHP 8.3+; PHPCompatibility enforces the PHP 8.0 source floor.
    phpVersion: 80300
    checkUninitializedProperties: true
    checkImplicitMixed: true
    checkBenevolentUnionTypes: true

    exceptions:
        implicitThrows: false
        check:
            missingCheckedExceptionInThrows: true
            tooWideThrowType: true
        uncheckedExceptionClasses:
            - LogicException
            - RuntimeException
            - Error
            - Random\RandomException
            - PHPUnit\Framework\MockObject\Exception

    customRules:
        testNamespacePrefixes:
            - 'OasFake\Tests'
        restrictedTestNamespacePrefixes:
            - 'OasFake\Tests\Unit'

    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: true
