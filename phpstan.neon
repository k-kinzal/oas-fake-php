# NOTE: You do not have permission to overwrite this file. Please ask a human operator to perform the changes for you.

includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/k-kinzal/php-ai-toolkit/extension.neon
    - vendor/k-kinzal/php-ai-toolkit/rules.neon

parameters:
    level: max
    paths:
        - src
        - tests
        - bench
        - fuzz
    scanFiles:
        - tests/Stubs/PHPUnitAttributes.stub
        - tests/Stubs/Override.stub
    checkUninitializedProperties: true
    checkImplicitMixed: true
    checkBenevolentUnionTypes: true
    toolkit:
        mutation:
            enabled: true
        forbiddenTermsByPath:
            'src/OpenApi/*':
                - VCR
                - cassette
                - interceptor
                - middleware
            'src/Generation/*':
                - VCR
                - cassette
                - interceptor
                - middleware
        testNamespacePrefixes:
            - 'OasFake\Tests'
        restrictedTestNamespacePrefixes:
            - 'OasFake\Tests\Unit'
        visibilityExemptNamespacePrefixes:
            - 'OasFake\Tests'
    ignoreErrors:
        -
            identifier: customRules.nonPublicMethod
            message: '#^Move private method __construct\(\) out of #'
            paths:
                - src/Application/FakeRequest.php
                - src/Application/FakeResponse.php
                - src/Exception/ValidationException.php
                - src/Handling/Handler.php
                - src/Interception/Mode.php
                - src/OpenApi/Schema.php
        -
            identifier: customRules.forbiddenClassLikeNameSuffix
            path: src/OpenApi/OperationInfo.php
            count: 1
    reportUnmatchedIgnoredErrors: true
