includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/k-kinzal/php-ai-toolkit/extension.neon
    - vendor/k-kinzal/php-ai-toolkit/error-formatter.neon

parameters:
    level: max
    paths:
        - src
        - tests
    excludePaths:
        - tests/Fixtures
    # Development tools run on PHP 8.3+; PHPCompatibility enforces the PHP 8.0 source floor.
    phpVersion: 80300
    checkUninitializedProperties: true
    checkImplicitMixed: true
    checkBenevolentUnionTypes: true

    customRules:
        testNamespacePrefixes:
            - 'OasFake\Tests'
        restrictedTestNamespacePrefixes:
            - 'OasFake\Tests\Unit'

    # These private constructors/factories are part of the unchanged public contract.
    # Making them public would expand the supported API solely to satisfy analysis.
    ignoreErrors:
        -
            identifier: customRules.nonPublicMethod
            paths:
                - src/Exception/ValidationException.php
                - src/Application/FakeRequest.php
                - src/Application/FakeResponse.php
                - src/Handling/Handler.php
                - src/Interception/Mode.php
                - src/OpenApi/Schema.php
        -
            identifier: customRules.forbiddenClassLikeNameSuffix
            path: src/OpenApi/OperationInfo.php
        -
            identifier: customRules.noBrokenCodeExpectation
            paths:
                - tests/Unit/Interception/CassetteSessionTest.php
                - tests/Unit/Interception/InterceptorTest.php
                - tests/Unit/Interception/ModeTest.php
                - tests/Unit/Application/ServerLifecycleTest.php
                - tests/Unit/Application/ServerRegistryTest.php
                - tests/Unit/Application/ServerTest.php

    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: true
